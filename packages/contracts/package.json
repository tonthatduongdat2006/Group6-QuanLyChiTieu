{
  "name": "@ase/contracts",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "check": "node scripts/check-openapi.mjs && redocly lint openapi.yaml && node scripts/check-fixtures.mjs",
    "gen": "openapi-typescript openapi.yaml -o src/generated/schema.d.ts",
