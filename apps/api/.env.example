# API server
PORT=3000

# Database – Supabase PostgreSQL via Session Pooler (P0-TD-01a)
# Copy this file to apps/api/.env and fill in real values locally.
# Never commit apps/api/.env. Never paste the real value into docs, logs or chat.
# Format (Supabase Dashboard > Connect > Session pooler):
#   postgresql://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres?sslmode=require"

# Prisma CLI: disable update/telemetry checkpoint so no cache file is written
# to the user profile directory (drive C:).
CHECKPOINT_DISABLE=1
