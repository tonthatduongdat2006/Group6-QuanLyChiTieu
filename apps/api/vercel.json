{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @ase/contracts gen && pnpm --filter @ase/api prisma:generate && pnpm --filter @ase/api build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "dist/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}
