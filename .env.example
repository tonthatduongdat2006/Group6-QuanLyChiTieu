# Sao chép thành apps/api/.env — KHÔNG commit file .env thật
# Local (docker-compose):
DATABASE_URL=postgresql://ase:ase_local_only@localhost:5432/ase_dev
DIRECT_URL=postgresql://ase:ase_local_only@localhost:5432/ase_dev
# Supabase (deploy): dùng pooler (port 6543, ?pgbouncer=true) cho DATABASE_URL và kết nối trực tiếp (5432) cho DIRECT_URL
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=900
REFRESH_TTL=2592000
REFRESH_REUSE_GRACE_SECONDS=10
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL_CHAT=
AI_MODEL_SCAN=claude-opus-5-5
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1
AI_MAX_DRAFTS_PER_MESSAGE=10
RECEIPT_MAX_BYTES=4194304
RECEIPT_ALLOWED_MIME=image/jpeg,image/png,image/webp
SCAN_LIMIT_PER_HOUR=20
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
TZ_DISPLAY=Asia/Ho_Chi_Minh
CORS_ORIGINS=
PORT=3000
